import os, base64, requests, json
from kaggle_secrets import UserSecretsClient

user_secrets = UserSecretsClient()
GITHUB_TOKEN = user_secrets.get_secret("GITHUB")

GITHUB_REPO = "GP7846/FedRAG"
BRANCH      = "main"
HEADERS     = {
    "Authorization": f"token {GITHUB_TOKEN}",
    "Accept":        "application/vnd.github.v3+json",
}

# Find notebook file
notebook_path = None
for f in os.listdir("/kaggle/working"):
    if f.endswith(".ipynb"):
        notebook_path = f"/kaggle/working/{f}"
        print(f"Found notebook: {f}")
        break

if notebook_path is None:
    # Search in input
    for root, dirs, files in os.walk("/kaggle"):
        for f in files:
            if f.endswith(".ipynb"):
                notebook_path = os.path.join(root, f)
                print(f"Found notebook: {notebook_path}")
                break
        if notebook_path:
            break

if notebook_path:
    with open(notebook_path, "rb") as f:
        content = base64.b64encode(f.read()).decode("utf-8")

    repo_path = "FedRAG_CORE_v2_experiment.ipynb"
    url  = f"https://api.github.com/repos/{GITHUB_REPO}/contents/{repo_path}"
    resp = requests.get(url, headers=HEADERS)
    sha  = resp.json().get("sha") if resp.status_code == 200 else None

    payload = {
        "message": "Add complete experiment notebook",
        "content": content,
        "branch":  BRANCH,
    }
    if sha:
        payload["sha"] = sha

    resp = requests.put(url, headers=HEADERS, json=payload)
    if resp.status_code in [200, 201]:
        print(f"✅ Notebook uploaded successfully")
        print(f"View: https://github.com/{GITHUB_REPO}")
    else:
        print(f"❌ Failed: {resp.json().get('message','error')}")
else:
    print("❌ No notebook found")
    print("Files in /kaggle/working:")
    print(os.listdir("/kaggle/working"))
